# ──────────────────────────────────────────────────────────────────────────────
# Intelliginet File System — environment configuration
#
# Copy this file to  .env  and edit as needed.
# All variables have sensible defaults — only override what you need to change.
# ──────────────────────────────────────────────────────────────────────────────

# ── Directory paths ────────────────────────────────────────────────────────────
# Absolute paths inside the container (or on the host if running without Docker)
INPUT_DIR=/app/data/input
OUTPUT_DIR=/app/data/output
LOG_DIR=/app/logs
LOG_FILE=/app/logs/system.log
MODEL_DIR=/app/app/model/weights

# ── Logging ────────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT: json (machine-readable) | text (human-readable)
LOG_FORMAT=json

# ── Processing ─────────────────────────────────────────────────────────────────
# Number of parallel worker threads for file processing
MAX_WORKERS=4
# Minimum seconds between re-processing the same modified file (debounce)
DEBOUNCE_SECONDS=2.0
# Seconds to wait after a file is detected before reading it (write-settle delay)
FILE_WRITE_DELAY=0.5

# ── ML ─────────────────────────────────────────────────────────────────────────
# IsolationForest contamination: "auto" or a float between 0.0 and 0.5
ANOMALY_CONTAMINATION=auto
